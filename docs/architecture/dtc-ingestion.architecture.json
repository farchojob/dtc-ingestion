  "cards": [
    {
      "dot": "cyan",
      "title": "What a run survives",
      "items": [
        "Same file twice: sha256 already loaded, nothing changes",
        "Dies mid-file: next run resumes from rows_committed",
        "Column renamed: declared alias used, schema event logged",
        "Records for a reported day: rebuilt, every move restated"
      ]
    },
    {
      "dot": "rose",
      "title": "Tenancy",
      "items": [
        "tenant_id on every row; RLS enabled and forced, 15 tables",
        "withTenant(): BEGIN · set_config · COMMIT, the only door",
        "No context: zero rows. Another tenant: insert refused"
      ]
    },
    {
      "dot": "amber",
      "title": "Missing and late",
      "items": [
        "Missing batch: check exits 1 and says how overdue",
        "Missing spend: NULL and complete = false, never zero",
        "restate or freeze per tenant, decided at staging"
      ]
    }
  ]
