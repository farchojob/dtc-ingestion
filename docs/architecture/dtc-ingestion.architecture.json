    "views": [
      {
        "id": "a-run",
        "label": "A run, phase by phase",
        "focus": [
          "cli",
          "ingest",
          "stage",
          "marts",
          "checks"
        ],
        "note": "ingest, stage, marts, checks: each phase is idempotent on its own, so any run can be repeated."
      },
      {
        "id": "where-data-lands",
        "label": "Where the data lands",
        "focus": [
          "deliveries",
          "raw",
          "stg",
          "mart"
        ],
        "note": "raw keeps every line as delivered; stg holds one row per natural key; mart holds only rebuilt days."
      },
      {
        "id": "evidence",
        "label": "Evidence, never silence",
        "focus": [
          "stage",
          "marts",
          "checks",
          "ops"
        ],
        "note": "Held rows, conflicts, schema events, restatements and missing deliveries are rows you can query."
      },
      {
        "id": "tenancy",
        "label": "Tenancy the database enforces",
        "focus": [
          "raw",
          "stg",
          "mart",
          "ops",
          "console"
        ],
        "note": "Row-level security is forced; app_rw cannot bypass it; withTenant() is the only door in."
      },
      {
        "id": "third-client",
        "label": "The third client",
        "focus": [
          "config",
          "cli"
        ],
        "note": "Acme is one YAML file: currency, paths, label maps, two policies. No code, no migration."
      }
    ],
