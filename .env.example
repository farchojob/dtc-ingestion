# Copy to .env (the pipeline and the console both read it).
# Admin connection: migrations, role creation, cross-tenant checks. Superuser in the docker image.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/dtc
# Application connection: everything that touches tenant data. This role cannot bypass row-level security.
APP_DATABASE_URL=postgres://app_rw:app_rw@localhost:5433/dtc
# Where the config and the fixtures live, relative to the repo root.
DTC_CONFIG_DIR=config
DTC_FIXTURES_DIR=fixtures
